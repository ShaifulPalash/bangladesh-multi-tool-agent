# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to GitHub — only this example file.

# --- LLM provider (choose ONE and set it) ---
# OpenAI (default in this project)
OPENAI_API_KEY=your_openai_api_key_here (sk-xxxxxxxxxxxxxxxxxxxxxxxx)

# Google Gemini LLM provider
# Get your API key from Google AI Studio:
# https://aistudio.google.com/

GEMINI_API_KEY=your_gemini_api_key_here
AGENT_MODEL=your_gemini_model_name_here

# If you'd rather use Anthropic's Claude instead of OpenAI, uncomment this
# and see the note in agent/main_agent.py for the two-line swap.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Web search tool ---
# Get a free key at https://app.tavily.com (1000 free searches/month).
# If you leave this blank, the project automatically falls back to
# DuckDuckGo search, which needs NO API key at all.
TAVILY_API_KEY=your_tavily_api_key_here
